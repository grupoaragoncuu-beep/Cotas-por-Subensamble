        lblJob.Text = "Job en proceso (VSM)"
        lblJob.Font = New Font("Segoe UI", 9, FontStyle.Bold)
        lblJob.ForeColor = System.Drawing.Color.LightGray
        lblJob.Location = New System.Drawing.Point(60, 82)
        lblJob.Size = New Size(280, 18)

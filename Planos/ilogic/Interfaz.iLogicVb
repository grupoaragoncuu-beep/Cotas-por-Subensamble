' COTAS ABIGAIL - Interfaz de los 3 procesos
' Misma ventana que Interfaz.iLogicVb (STEP): borde redondo, arrastre, Iniciar.
'
' Asignacion, en orden de importacion:
'   Cotas por piezas           -> COTAS_ILOGIC_ABIGAIL.iLogicVb
'   Cotas por subensamble      -> COTAS_POR_SUBENSAMBLE.iLogicVb
'   Ensambles independientes   -> COTAS_ENSAMBLES_INDEPENDIENTES.iLogicVb
'
' Las reglas se buscan en la carpeta iLogic (ExternalRuleDirectories
' o COTAS_ABIGAIL_DIR\ilogic). No se fija una unidad de esta PC.
'
' El plano machote no tiene que estar abierto. Si ya lo esta, se usa.
' Si no, se abre desde MACHOTE en ilogic\config_planos.txt, o desde
' Planos\MACHOTE PLANOS.dwg. El usuario deja el ensamble abierto y,
' en tanque, solo escoge TOP, segmentos y BASE.

AddReference "System.Windows.Forms"
AddReference "System.Drawing"
Imports System.Windows.Forms
Imports System.Drawing
Imports System.Drawing.Drawing2D
Imports System.Diagnostics
Imports Inventor
Imports DrawingPoint = System.Drawing.Point

Public Class CotasProcessForm
    Inherits Form

    Private btnSubensamble, btnPiezas, btnEnsambles, btnClose, btnRutaEspecial As Button
    Private cboJobs As ComboBox
    Private lblJob As New Label()
    Private lblRuta As New Label()
    Private rutaEspecialRaiz As String = ""
    Private rutaEspecialJpgs As String = ""
    Private clienteEspecial As String = ""
    Private productoEspecial As String = ""
    Private ignorarCambioJob As Boolean = False
    Private lblTitle As New Label()
    Private titlePanel As New Panel()
    Private invApp As Inventor.Application
    Private invDoc As Inventor.Document
    Private jobsVsm As New System.Collections.Generic.List(Of String())

    Private isDragging As Boolean = False
    Private dragCursor As DrawingPoint
    Private dragForm As DrawingPoint

    Public Sub New(app As Inventor.Application, doc As Inventor.Document)
        invApp = app
        invDoc = doc

        Me.FormBorderStyle = FormBorderStyle.None
        Me.StartPosition = FormStartPosition.CenterScreen
        Me.ClientSize = New Size(400, 470)
        Me.BackColor = System.Drawing.ColorTranslator.FromHtml("#1e2a38")
        Me.Opacity = 0.85
        Me.DoubleBuffered = True
        Me.TopMost = True
        Me.Region = New Region(CreateRoundedRectanglePath(New Rectangle(0, 0, Me.Width, Me.Height), 25))

        AddHandler Me.MouseDown, AddressOf DragMouseDown
        AddHandler Me.MouseMove, AddressOf DragMouseMove
        AddHandler Me.MouseUp, AddressOf DragMouseUp

        titlePanel.Width = 280
        titlePanel.Height = 50
        titlePanel.Location = New System.Drawing.Point(60, 20)
        titlePanel.BackColor = System.Drawing.ColorTranslator.FromHtml("#2a3b4c")
        titlePanel.Region = New Region(CreateRoundedRectanglePath(New Rectangle(0, 0, titlePanel.Width, titlePanel.Height), 20))
        Me.Controls.Add(titlePanel)

        lblTitle.Text = "COTAS ABIGAIL"
        lblTitle.Font = New Font("Segoe UI", 14, FontStyle.Bold)
        lblTitle.ForeColor = System.Drawing.Color.White
        lblTitle.Dock = DockStyle.Fill
        lblTitle.TextAlign = ContentAlignment.MiddleCenter
        titlePanel.Controls.Add(lblTitle)

        AddHandler titlePanel.MouseDown, AddressOf DragMouseDown
        AddHandler titlePanel.MouseMove, AddressOf DragMouseMove
        AddHandler titlePanel.MouseUp, AddressOf DragMouseUp
        AddHandler lblTitle.MouseDown, AddressOf DragMouseDown
        AddHandler lblTitle.MouseMove, AddressOf DragMouseMove
        AddHandler lblTitle.MouseUp, AddressOf DragMouseUp

        btnClose = New Button()
        btnClose.Text = "X"
        btnClose.Font = New Font("Segoe UI", 9, FontStyle.Bold)
        btnClose.ForeColor = System.Drawing.Color.White
        btnClose.BackColor = System.Drawing.ColorTranslator.FromHtml("#444")
        btnClose.FlatStyle = FlatStyle.Flat
        btnClose.FlatAppearance.BorderSize = 0
        btnClose.Size = New Size(30, 30)
        btnClose.Location = New System.Drawing.Point(Me.Width - 40, 10)
        AddHandler btnClose.Click, Sub() Me.Close()
        Me.Controls.Add(btnClose)

        Dim buttonFont As New Font("Segoe UI", 10, FontStyle.Bold)
        Dim buttonColor As System.Drawing.Color = System.Drawing.ColorTranslator.FromHtml("#007bff")
        Dim buttonHoverColor As System.Drawing.Color = System.Drawing.ColorTranslator.FromHtml("#3399ff")

        btnPiezas = CrearBoton("Cotas por piezas", New System.Drawing.Point(60, 228), buttonFont, buttonColor, buttonHoverColor)
        AddHandler btnPiezas.Click, Sub() AbrirSubProceso(
            "Cotas por piezas",
            "Medidas de fabricacion de cada pieza: largo, ancho, espesor, altura, pata y angulo. Omite Almacen. En BOARD el cobre marca solo las dos primeras X y las dos primeras Y.")

        btnSubensamble = CrearBoton("Cotas por subensamble", New System.Drawing.Point(60, 278), buttonFont, buttonColor, buttonHoverColor)
        AddHandler btnSubensamble.Click, Sub() AbrirSubProceso(
            "Cotas por subensamble",
            "Ubicacion de cada pieza respecto al (0,0) de la cara. En tanque pide TOP, SEGM1 a SEGM4 y BASE. En tablero BOARD no pide caras: genera las vistas del kit.")

        btnEnsambles = CrearBoton("Ensambles independientes", New System.Drawing.Point(60, 328), buttonFont, buttonColor, buttonHoverColor)
        AddHandler btnEnsambles.Click, Sub() AbrirSubProceso(
            "Ensambles independientes",
            "Kits que no son el casco ni el TOP. Seis vistas, inspeccion visual sin cotas y accesorios sueltos por pieza.")

        Me.Controls.AddRange({btnPiezas, btnSubensamble, btnEnsambles})
        ArmarListaJobs()
        CargarJobsVsm()
    End Sub

    Private Function CrearBoton(texto As String, posicion As System.Drawing.Point, font As Font,
                                baseColor As System.Drawing.Color, hoverColor As System.Drawing.Color) As Button
        Dim btn As New Button()
        btn.Text = texto
        btn.Size = New Size(280, 40)
        btn.Location = posicion
        btn.FlatStyle = FlatStyle.Flat
        btn.FlatAppearance.BorderSize = 0
        btn.BackColor = baseColor
        btn.ForeColor = System.Drawing.Color.White
        btn.Font = font
        btn.Region = New Region(CreateRoundedRectanglePath(New Rectangle(0, 0, btn.Width, btn.Height), 20))
        AddHandler btn.MouseEnter, Sub() btn.BackColor = hoverColor
        AddHandler btn.MouseLeave, Sub() btn.BackColor = baseColor
        Return btn
    End Function

    Private Sub AbrirSubProceso(titulo As String, descripcion As String)
        If Not HayDestino() Then
            MessageBox.Show("Selecciona el job del VSM o una ruta especial.")
            Return
        End If
        Dim ventana As New SubProcessForm(titulo, descripcion, AddressOf EjecutarProcesoYReiniciar)
        ventana.Owner = Me
        ventana.ShowDialog()
    End Sub

    Private Sub EjecutarProcesoYReiniciar(proceso As String)
        Me.Invoke(Sub() Me.Close())
        Dim hilo As New Threading.Thread(Sub()
                                             System.Threading.Thread.Sleep(200)
                                             EjecutarProceso(proceso)
                                             Try
                                                 Dim newForm As New CotasProcessForm(invApp, invDoc)
                                                 newForm.TopMost = True
                                                 AddHandler newForm.Shown, Sub()
                                                                              newForm.Activate()
                                                                              newForm.BringToFront()
                                                                          End Sub
                                                 newForm.ShowDialog()
                                             Catch ex As Exception
                                                 MessageBox.Show("Error al relanzar la interfaz: " & ex.Message)
                                             End Try
                                         End Sub)
        hilo.SetApartmentState(Threading.ApartmentState.STA)
        hilo.Start()
    End Sub

    Private Sub EjecutarProceso(proceso As String)
        If Not HayEnsambleAbierto() Then
            MessageBox.Show("Abre el ensamble (.iam) y vuelve a iniciar el proceso." & vbCrLf &
                            "El plano machote se abre solo.")
            Return
        End If

        If Not AplicarJobVsm() Then Return

        Dim plano As Document = AsegurarMachote()
        If plano Is Nothing Then Return
        invDoc = plano

        Dim iLogicAutomation As Object = GetiLogicAutomation(invApp)
        If iLogicAutomation Is Nothing Then
            MessageBox.Show("No se pudo obtener iLogic.")
            Return
        End If

        Dim nombreRegla As String = ""
        Select Case proceso
            Case "Cotas por subensamble"
                nombreRegla = "COTAS_POR_SUBENSAMBLE.iLogicVb"
            Case "Cotas por piezas"
                nombreRegla = "COTAS_ILOGIC_ABIGAIL.iLogicVb"
            Case "Ensambles independientes"
                nombreRegla = "COTAS_ENSAMBLES_INDEPENDIENTES.iLogicVb"
            Case Else
                MessageBox.Show("Proceso no reconocido: " & proceso)
                Return
        End Select

        Dim rutaCompleta As String = ResolverRutaRegla(nombreRegla)
        If rutaCompleta <> "" AndAlso System.IO.File.Exists(rutaCompleta) Then
            Try
                plano.Activate()
            Catch
            End Try
            iLogicAutomation.RunExternalRule(plano, rutaCompleta)
        Else
            MessageBox.Show("No se encontro la regla " & nombreRegla & " en la carpeta iLogic.")
        End If
    End Sub

    Private Function ResolverRutaRegla(nombreRegla As String) As String
        Dim candidatos As New System.Collections.Generic.List(Of String)
        Try
            Dim env As String = System.Environment.GetEnvironmentVariable("COTAS_ABIGAIL_DIR")
            If Not String.IsNullOrWhiteSpace(env) Then
                candidatos.Add(System.IO.Path.Combine(env, "ilogic", nombreRegla))
            End If
        Catch
        End Try
        Try
            Dim addIn As ApplicationAddIn =
                invApp.ApplicationAddIns.ItemById("{3bdd8d79-2179-4b11-8a5a-257b1c0263ac}")
            If Not addIn.Activated Then addIn.Activate()
            Dim dirs As Object = addIn.Automation.FileOptions.ExternalRuleDirectories
            If dirs IsNot Nothing Then
                For Each d As String In dirs
                    If String.IsNullOrWhiteSpace(d) Then Continue For
                    candidatos.Add(System.IO.Path.Combine(d, nombreRegla))
                    candidatos.Add(System.IO.Path.Combine(d, "ilogic", nombreRegla))
                Next
            End If
        Catch
        End Try
        For Each ruta As String In candidatos
            If System.IO.File.Exists(ruta) Then Return ruta
        Next
        Return ""
    End Function


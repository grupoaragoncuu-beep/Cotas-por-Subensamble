        cboJobs.DropDownStyle = ComboBoxStyle.DropDownList
        cboJobs.Font = New Font("Segoe UI", 9, FontStyle.Bold)
        cboJobs.BackColor = System.Drawing.ColorTranslator.FromHtml("#2a3b4c")
        cboJobs.ForeColor = System.Drawing.Color.White
        cboJobs.FlatStyle = FlatStyle.Flat
        cboJobs.Size = New Size(280, 28)
        cboJobs.Location = New System.Drawing.Point(60, 104)
